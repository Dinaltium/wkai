# ── WKAI backend environment ──────────────────────────────────────────────────
# Copy to .env and fill in. Do NOT commit the real .env (it is gitignored).

# Server
PORT=4000
# development enables verbose query/HTTP logging; set to "production" in prod
NODE_ENV=development

# ── Datastores ────────────────────────────────────────────────────────────────
# Local Docker defaults shown; replace with your managed URLs in prod (e.g. Neon).
DATABASE_URL=postgres://wkai:wkai@localhost:5432/wkai
REDIS_URL=redis://localhost:6379
# Optional Postgres pool tuning
PG_POOL_MAX=20
PG_CONNECT_TIMEOUT_MS=20000

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com (no card required)
GROQ_API_KEY=
# Optional LangSmith tracing — leave blank to disable
LANGSMITH_API_KEY=

# Per-session / global AI concurrency caps (protect Groq rate limits at scale)
AI_PER_SESSION_CONCURRENCY=2
AI_GLOBAL_CONCURRENCY=8
AI_MAX_QUEUE_PER_SESSION=50

# Per-agent feature flags (default: enabled if unset). Set to false to disable.
# AI_AGENT_VOICE_AGENT_ENABLED=true
# AI_AGENT_QUIZ_AGENT_ENABLED=true
# AI_AGENT_DEBUG_AGENT_ENABLED=true
# AI_AGENT_INTENT_AGENT_ENABLED=true
# AI_AGENT_MESSAGE_AGENT_ENABLED=true

# ── File storage (Cloudinary) ─────────────────────────────────────────────────
# Free 25 GB tier at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production — signs instructor/student session tokens. The backend
# refuses to start in production if this is unset (falls back to an insecure dev
# default only in non-production). Generate a long random value.
STUDENT_JOIN_TOKEN_SECRET=
# Token lifetimes (seconds). Defaults: student 8h, instructor 12h.
STUDENT_JOIN_TOKEN_TTL_SECONDS=28800
INSTRUCTOR_TOKEN_TTL_SECONDS=43200

# Comma-separated allowed frontend origins (student/landing domains). Required in
# prod; localhost and private LAN IPs are always allowed.
CORS_ALLOWED_ORIGINS=
